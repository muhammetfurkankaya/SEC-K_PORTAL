# SEÇ-K Portalı — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayıp doldurun. .env sürüm kontrolüne girmez.

# Oturum cookie'lerini imzalayan gizli anahtar.
# ÜRETİMDE MUTLAKA VERİN — en az 16 karakter, rastgele.
# Boş bırakılırsa data/session-secret dosyasında otomatik üretilir.
# Üretmek için:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECK_SESSION_SECRET=

# Anket QR kodlarına gömülecek kök adres.
# Ters vekil (nginx / IIS) arkasında çalışırken ayarlayın.
# Örnek: https://seck.turkishfuel.com
SECK_BASE_URL=

# Veritabanı ve yüklenen PDF'lerin tutulacağı klasör.
# Boş bırakılırsa proje kökündeki data/ kullanılır.
# Örnek (Windows): D:\seck-data
SECK_DATA_DIR=

# HTTPS üzerinden yayınlıyorsanız true yapın.
# Intranette HTTP kullanılıyorsa false kalmalı, aksi halde giriş yapılamaz.
SECK_SECURE_COOKIE=false

# Uygulamanın dinleyeceği port.
PORT=3000
