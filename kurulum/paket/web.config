<?xml version="1.0" encoding="utf-8"?>
<!--
  SEC-K Portali - IIS uygulama yapilandirmasi
  ===========================================

  Bu dosya paketin kokunde duruyor: IIS'te bu klasoru gosteren bir site
  olusturmak yeterlidir, baska bir dosya duzenlemeniz gerekmez.

  GEREKEN TEK IIS EKLENTISI: HttpPlatformHandler 1.2
    https://www.iis.net/downloads/microsoft/httpplatformhandler

  Yapmaniz gerekenler (ayrinti: iis\IIS.md):
    1. Node.js 20 LTS kurun (nodejs.org)
    2. HttpPlatformHandler kurun
    3. IIS'te bu klasoru gosteren bir site olusturun
    4. Uygulama havuzu kimligine data\ klasorune yazma izni verin

  Yollar bilincli olarak GORECELI: paket hangi klasorde olursa olsun calisir.
  Node.js baska bir yere kuruluysa yalnizca processPath satirini duzeltin.
-->
<configuration>
  <system.webServer>

    <!-- Tum istekler portal surecine gider; IIS statik dosya sunmaz.
         Bu yuzden .env veya data\ altindaki dosyalar dis dunyaya acilmaz. -->
    <handlers>
      <remove name="httpPlatformHandler" />
      <add name="httpPlatformHandler" path="*" verb="*"
           modules="httpPlatformHandler" resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <!--
      arguments goreceli: HttpPlatformHandler surecin calisma klasorunu
      uygulamanin fiziksel yoluna ayarlar. baslat.cjs ayrica kendi klasorune
      gecerek bunu garanti altina alir.

      stdoutLogEnabled: portal acilamazsa tarayici yalnizca 502.5 gosterir;
      gercek hata data\iis-log\ altindaki dosyaya yazilir. Sorun ararken
      ilk bakilacak yer orasi.
    -->
    <httpPlatform processPath="%ProgramFiles%\nodejs\node.exe"
                  arguments=".\baslat.cjs"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\data\iis-log\portal"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:04:00">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <!-- Bulten PDF'leri icin 25 MB sinir var; IIS varsayilani (~28 MB)
             cok yakin oldugu icin yukseltiyoruz. -->
        <requestLimits maxAllowedContentLength="52428800" />

        <!-- Ikinci katman: handler devre disi kalsa bile bu yollar ve
             uzantilar sunulmaz. -->
        <hiddenSegments>
          <add segment="data" />
          <add segment="komutlar" />
          <add segment="sqlite-ikili" />
          <add segment="node_modules" />
          <add segment="iis" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".cjs" allowed="false" />
          <add fileExtension=".node" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <directoryBrowse enabled="false" />

    <httpProtocol>
      <customHeaders>
        <!-- Hangi surumu calistirdigimizi duyurmanin faydasi yok. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- Portalin kendi hata sayfalari gorunsun; IIS araya girmesin. -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
