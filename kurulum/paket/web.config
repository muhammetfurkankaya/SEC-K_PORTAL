<?xml version="1.0" encoding="utf-8"?>
<!--
  SEC-K Portali - IIS baslangic yapilandirmasi (KURULUM ONCESI)
  =============================================================

  Bu dosya bilincli olarak HICBIR IIS eklentisi gerektirmez. Yalnizca IIS'in
  kendi bolumlerini kullanir, boylece site her zaman acilir ve tarayicida
  "500.19" hatasi yerine kurulum.html bilgi sayfasi gorunur.

  Ne yapar:
    - Butun istekler kurulum.html sayfasina duser (varsayilan belge)
    - .html DISINDA hicbir dosya sunulmaz (allowUnlisted="false")
    - data\, komutlar\, node_modules\ gibi yollar ayrica gizlenir
    Yani veritabani, .env ve PDF'ler kurulum tamamlanmadan once de disariya
    kapalidir.

  Kurulum tamamlandiginda iis-kur.ps1 bu dosyanin yerine
  iis\web.config.iis dosyasini koyar; portal o zaman calisir.
  Elle yapmak isterseniz:

    copy iis\web.config.iis web.config

  Not: portali IIS olmadan yayinlayacaksaniz (bkz. iis\IIS.md "B seceneği")
  bu dosyaya hic dokunmaniz gerekmez.
-->
<configuration>
  <system.webServer>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="kurulum.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering>
        <!-- allowUnlisted="false": listede olmayan hicbir uzanti sunulmaz.
             .env, .db, .json, .cjs, .js hepsi bu kuralla kapali kalir. -->
        <fileExtensions allowUnlisted="false">
          <add fileExtension=".html" allowed="true" />
        </fileExtensions>

        <hiddenSegments>
          <add segment="data" />
          <add segment="komutlar" />
          <add segment="sqlite-ikili" />
          <add segment="node_modules" />
          <add segment="iis" />
          <add segment=".next" />
        </hiddenSegments>

        <!-- Bulten PDF yuklemeleri icin; kurulum sonrasi da gecerli olsun. -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
