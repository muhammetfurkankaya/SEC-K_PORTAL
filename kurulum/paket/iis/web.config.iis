<?xml version="1.0" encoding="utf-8"?>
<!--
  SEC-K Portali - IIS'in Node surecini kendi yonettigi yapilandirma
  (HttpPlatformHandler)

  Bu dosya IIS site klasorune "web.config" adiyla kopyalanir. IIS portali
  ilk istekte kendisi baslatir, cokerse yeniden baslatir; ayri bir
  zamanlanmis gorev gerekmez.

  Gerekenler:  HttpPlatformHandler 1.2
  Portu IIS secer (HTTP_PLATFORM_PORT) ve baslat.cjs bunu kullanir; .env
  icindeki PORT bu modda dikkate alinmaz.

  Elle kullaniyorsaniz duzeltilmesi gereken yollar:
    - C:\Program Files\nodejs\node.exe   -> node.exe'nin gercek yeri
    - C:\seckportal\baslat.cjs           -> paketin gercek yeri
    - C:\seckportal\data                 -> veri klasoru (iki yerde)

  iis-kur.ps1 bu yollari kendisi yaziyor; elle kurulum yapmiyorsaniz bu
  dosyayi duzenlemenize gerek yok.
-->
<configuration>
  <system.webServer>

    <handlers>
      <remove name="httpPlatformHandler" />
      <add name="httpPlatformHandler" path="*" verb="*"
           modules="httpPlatformHandler" resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments="&quot;C:\seckportal\baslat.cjs&quot;"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:04:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\seckportal\data\iis-log\portal">
      <environmentVariables>
        <!-- Veritabani ve PDF'lerin yeri. IIS surecin calisma klasorunu
             degistirebildigi icin acikca veriyoruz. -->
        <environmentVariable name="SECK_DATA_DIR" value="C:\seckportal\data" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <!-- Bulten PDF'leri icin 25 MB sinir var; IIS varsayilani (~28 MB)
             cok yakin oldugu icin yukseltiyoruz. -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <!-- Portalin kendi hata sayfalari gorunsun; IIS araya girmesin. -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
